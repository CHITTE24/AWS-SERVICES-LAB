{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:YOUR_REGION:YOUR_ACCOUNT_ID:log-group:/aws/lambda/YOUR_FUNCTION_NAME",
        "arn:aws:logs:YOUR_REGION:YOUR_ACCOUNT_ID:log-group:/aws/lambda/YOUR_FUNCTION_NAME:*"
      ]
    },
    {
      "Sid": "SendEmailOnlyFromTheLabSender",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:YOUR_REGION:YOUR_ACCOUNT_ID:identity/*",
      "Condition": { "StringEquals": { "ses:FromAddress": "YOUR_SENDER_EMAIL" } }
    }
  ]
}
