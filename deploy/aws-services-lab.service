# OPTIONAL systemd service file: keeps the app running on EC2 and restarts it after crashes or reboots.
# Not using systemd? Start the app by hand instead (docs/EC2_DEPLOYMENT.md, section 8A).
# Written for Ubuntu (default user "ubuntu"), with the repository cloned into /home/ubuntu/aws-services-lab.
# Install it with the commands in docs/EC2_DEPLOYMENT.md, section 8B (it is copied to /etc/systemd/system/).

[Unit]
Description=AWS Services Lab (FastAPI)
# Wait until the network is up before starting.
After=network-online.target
Wants=network-online.target

[Service]
# Run as the normal "ubuntu" account, not as root.
User=ubuntu
Group=ubuntu
# The folder the repository was cloned into. The app loads .env from this folder.
WorkingDirectory=/home/ubuntu/aws-services-lab
# Sends Python output to the journal immediately, so "journalctl -u aws-services-lab" is always up to date.
Environment=PYTHONUNBUFFERED=1
# SSH TUNNEL (default): listens only on 127.0.0.1 (the server itself). Reach it through an SSH tunnel.
# --no-proxy-headers: uvicorn ignores X-Forwarded-* headers, so nobody can fake "HTTPS" by sending one.
ExecStart=/home/ubuntu/aws-services-lab/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
# BEHIND AN HTTPS APPLICATION LOAD BALANCER: use this line INSTEAD (README: AWS Security Setup, step 10),
# and set TRUST_PROXY_HEADERS=true and SESSION_HTTPS_ONLY=true in .env.
# --forwarded-allow-ips must list ONLY the subnets the ALB runs in (replace the example ranges), so the
# X-Forwarded-Proto header is accepted from the ALB and from nobody else. Never use "*".
# Allow port 8000 in the instance security group ONLY from the ALB's security group.
#ExecStart=/home/ubuntu/aws-services-lab/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=10.0.1.0/24,10.0.2.0/24
# Restart automatically if the app crashes, after waiting 5 seconds.
Restart=on-failure
RestartSec=5
# On "systemctl stop", uvicorn receives SIGTERM, finishes requests in progress, then exits.
# If it has not stopped after 20 seconds, systemd stops it forcefully.
TimeoutStopSec=20
# Basic hardening: the app cannot gain extra privileges and gets its own private /tmp.
NoNewPrivileges=true
PrivateTmp=true

[Install]
# Start automatically when the server boots.
WantedBy=multi-user.target
