# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real values are never committed.
# NEVER put AWS access keys in this file. Use "aws configure" locally or an IAM role on EC2.

# Title shown at the top of every page.
APP_TITLE=AWS Services Lab

# AWS region used when a page does not ask for a specific region.
AWS_REGION=us-east-1

# Optional: name of a profile created with "aws configure --profile NAME". Leave empty to use the default.
AWS_PROFILE=

# Login username for the dashboard.
ADMIN_USERNAME=admin

# Password HASH (not the password itself). Create one with:
#   .venv\Scripts\python scripts\make_password_hash.py
ADMIN_PASSWORD_HASH=replace-with-output-of-make_password_hash

# Random secret used to sign the login cookie. Create one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-value

# Set to true only when the site is served over HTTPS (keeps the cookie off plain HTTP).
SESSION_HTTPS_ONLY=false

# Safety switch. Keep false: blocks any operation that could create, change, or delete AWS resources.
ALLOW_WRITE_OPERATIONS=false

# Where the SQLite history database is stored (relative to the project folder).
DATABASE_PATH=data/lab.db

# How much detail to write to logs: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
