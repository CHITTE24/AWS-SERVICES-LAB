# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real values are never committed.
# NEVER put AWS access keys or passwords in this file. Use "aws configure" locally or an IAM role on EC2.
# Every AWS value below is a REFERENCE (a name or ARN), never a secret value.

# ---------------- Application ----------------
# Title shown at the top of every page.
APP_TITLE=AWS Services Lab

# "local" = AWS services that are not configured are SIMULATED (clearly labelled, nothing sent to AWS).
# "aws"   = every AWS service must be configured. A missing setting is reported as Failed.
APP_MODE=local

# Random secret used to sign the login cookie. Create one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to true when the site is served over HTTPS. It adds the "Secure" flag to the login cookie.
# Keep false for http://127.0.0.1 on your own computer.
SESSION_HTTPS_ONLY=false

# HTTPS through a load balancer. Keep false for the SSH tunnel or your own computer.
# false: the X-Forwarded-Proto header is never believed (anyone can send it), so HTTPS through a proxy
#        is never reported as Connected.
# true:  ONLY behind your own HTTPS load balancer, and ONLY together with the uvicorn options
#        --proxy-headers --forwarded-allow-ips=<the load balancer's subnet range> (see docs/EC2_DEPLOYMENT.md).
TRUST_PROXY_HEADERS=false

# Safety switch for the services dashboard. Keep false: blocks operations that change AWS resources.
ALLOW_WRITE_OPERATIONS=false

# How much detail to write to logs: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# ---------------- AWS ----------------
# Region of your bucket, Lambda function, secret, and RDS database.
AWS_REGION=ap-south-1

# Optional (your PC only): a profile created with "aws configure --profile NAME". Leave EMPTY on EC2.
AWS_PROFILE=

# ---------------- Database ----------------
# Run history and (in local mode) form submissions are stored in this SQLite file.
DATABASE_PATH=data/lab.db

# Where form submissions go: "sqlite" (local file) or "postgres" (Amazon RDS for PostgreSQL).
DATABASE_BACKEND=sqlite

# Amazon RDS connection (fill in after creating the database). These are not secret.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
# TLS for the database connection. verify-full = encrypted AND the RDS certificate is checked.
DB_SSLMODE=verify-full
# Path to the RDS certificate bundle, for example /home/ubuntu/aws-services-lab/certs/global-bundle.pem
DB_SSLROOTCERT=
# LOCAL DEVELOPMENT ONLY (a PostgreSQL on your own PC). Ignored when APP_MODE=aws.
DB_PASSWORD=

# ---------------- AWS Secrets Manager ----------------
# TODO (AWS SETUP): After creating the AWS Secrets Manager secret, put its NAME or ARN here.
# Never put the actual secret value in this file. Expected secret JSON: {"username": "...", "password": "..."}
AWS_SECRETS_MANAGER_SECRET_NAME=
# Seconds a retrieved secret is kept in memory before it is read again (900 = 15 minutes).
SECRET_CACHE_SECONDS=900

# ---------------- Amazon S3 + AWS KMS ----------------
# Private bucket for uploaded documents.
S3_BUCKET_NAME=
# ARN of the customer-managed KMS key (arn:aws:kms:REGION:ACCOUNT:key/ID). Use the KEY ARN, not an alias.
S3_KMS_KEY_ARN=

# ---------------- AWS Lambda / SES / SNS / SQS ----------------
# Name or ARN of the submission-processing Lambda function (deploy/lambda_function/submission_processor.py).
LAMBDA_FUNCTION_NAME=
# Optional. Leave empty to skip.
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
# NOTE: the SES sender address (SES_SENDER_EMAIL) is set on the LAMBDA FUNCTION's environment,
# not here, because the Lambda function sends the email.

# ---------------- Live Workflow Monitor ----------------
# Where REAL workflows keep their stages: "sqlite" (local file) or "dynamodb" (the table below).
# Simulated workflows always stay in the local file and never contact AWS.
WORKFLOW_BACKEND=sqlite
WORKFLOW_TABLE_NAME=aws-lab-workflows
# The Lambda function that S3 events trigger (Phase 3). Empty: no Lambda stages are expected.
WORKFLOW_LAMBDA_NAME=
# Seconds to wait for the S3 event / the Lambda result before showing "Timed Out".
# Timed Out is NOT proof of failure: a late result still updates the stage.
WORKFLOW_EVENT_DEADLINE_SECONDS=120
WORKFLOW_PROCESSING_DEADLINE_SECONDS=300
# Cost controls: the page stops asking for updates after this many seconds, and each user may start at
# most this many REAL workflows per hour (simulated ones are free and not counted).
WORKFLOW_POLL_LIMIT_SECONDS=300
WORKFLOW_MAX_PER_HOUR=30
# DynamoDB deletes workflow stages after this many days (Time To Live). The local list keeps every workflow.
WORKFLOW_RETENTION_DAYS=7
